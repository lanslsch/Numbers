* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Segoe UI', system-ui, sans-serif;
  background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
  min-height: 100vh;
  color: #1e293b;
}

/* ===== ТЕРМИНАЛ ===== */
.terminal-container {
  max-width: 900px;
  margin: 0 auto;
  padding: 40px 20px;
  text-align: center;
  color: #fff;
}

.terminal header h1 { font-size: 2.5em; margin-bottom: 10px; }
.subtitle { font-size: 1.2em; opacity: 0.85; margin-bottom: 40px; }

.services {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 40px;
}

.service-btn {
  background: rgba(255,255,255,0.95);
  border: none;
  border-radius: 20px;
  padding: 40px 20px;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.15);
}

.service-btn:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.25);
}

.service-btn:active { transform: translateY(0); }
.service-btn .icon { font-size: 3em; }
.service-btn .title { font-size: 1.3em; font-weight: 600; color: #1e3a8a; }

.current-ticket {
  background: rgba(0,0,0,0.25);
  border-radius: 16px;
  padding: 25px;
  backdrop-filter: blur(10px);
}

.current-ticket p { font-size: 1.1em; opacity: 0.9; }
.current-number {
  font-size: 4em;
  font-weight: 800;
  letter-spacing: 4px;
  margin-top: 10px;
}

/* Модальное окно номерка */
.ticket-modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.ticket-modal.active { display: flex; }

.ticket-card {
  background: #fff;
  border-radius: 24px;
  padding: 50px 60px;
  text-align: center;
  animation: pop 0.3s ease;
  box-shadow: 0 20px 60px rgba(0,0,0,0.4);
}

@keyframes pop {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.ticket-label { color: #64748b; font-size: 1.2em; }
.ticket-number {
  font-size: 5em;
  font-weight: 900;
  color: #1e3a8a;
  letter-spacing: 6px;
  margin: 15px 0;
}
.ticket-service { font-size: 1.4em; color: #3b82f6; font-weight: 600; }
.ticket-time { color: #94a3b8; margin: 15px 0 25px; }

.close-btn {
  background: #3b82f6;
  color: #fff;
  border: none;
  padding: 15px 50px;
  border-radius: 12px;
  font-size: 1.1em;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}
.close-btn:hover { background: #1e3a8a; }

/* ===== ОПЕРАТОР ===== */
.operator-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 30px 20px;
}

.operator header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #fff;
  margin-bottom: 30px;
}
.operator header h1 { font-size: 2em; }

.status-badge {
  background: #10b981;
  color: #fff;
  padding: 10px 25px;
  border-radius: 30px;
  font-weight: 600;
}
.status-badge.busy { background: #f59e0b; }

.operator-main {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

.call-panel, .current-panel, .stats-panel, .queue-list {
  background: #fff;
  border-radius: 16px;
  padding: 25px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}

.call-panel h2, .current-panel h2, .stats-panel h2, .queue-list h2 {
  font-size: 1.2em;
  color: #1e3a8a;
  margin-bottom: 20px;
}

#serviceSelect {
  width: 100%;
  padding: 14px;
  border: 2px solid #e2e8f0;
  border-radius: 10px;
  font-size: 1em;
  margin-bottom: 15px;
}

.call-btn {
  width: 100%;
  background: #3b82f6;
  color: #fff;
  border: none;
  padding: 16px;
  border-radius: 10px;
  font-size: 1.1em;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
}
.call-btn:hover { background: #1e3a8a; }

.big-number {
  font-size: 4em;
  font-weight: 900;
  color: #1e3a8a;
  text-align: center;
  margin: 20px 0;
  letter-spacing: 4px;
}

.complete-btn {
  width: 100%;
  background: #10b981;
  color: #fff;
  border: none;
  padding: 16px;
  border-radius: 10px;
  font-size: 1.1em;
  font-weight: 600;
  cursor: pointer;
}
.complete-btn:disabled { background: #cbd5e1; cursor: not-allowed; }

.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }

.stat-card {
  background: #f1f5f9;
  border-radius: 12px;
  padding: 20px;
  text-align: center;
}
.stat-value { display: block; font-size: 2.5em; font-weight: 800; color: #1e3a8a; }
.stat-label { color: #64748b; font-size: 0.95em; }

.queue-list ul { list-style: none; }
.queue-list li {
  display: flex;
  justify-content: space-between;
  padding: 12px 16px;
  border-bottom: 1px solid #e2e8f0;
}
.queue-list li .num { font-weight: 700; color: #1e3a8a; }
.queue-list li .svc { color: #64748b; }

@media (max-width: 768px) {
  .services { grid-template-columns: 1fr; }
  .operator-main { grid-template-columns: 1fr; }
} 
