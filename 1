<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Терминал выдачи номерков</title>
  <link rel="stylesheet" href="style.css">
</head>
<body class="terminal">
  <div class="terminal-container">
    <header>
      <h1>📋 Электронная очередь</h1>
      <p class="subtitle">Нажмите кнопку, чтобы получить номерок</p>
    </header>

    <div class="services">
      <button class="service-btn" data-service="consultation">
        <span class="icon">💬</span>
        <span class="title">Консультация</span>
      </button>
      <button class="service-btn" data-service="payment">
        <span class="icon">💳</span>
        <span class="title">Оплата</span>
      </button>
      <button class="service-btn" data-service="documents">
        <span class="icon">📄</span>
        <span class="title">Документы</span>
      </button>
    </div>

    <div class="current-ticket">
      <p>Сейчас обслуживается:</p>
      <div class="current-number" id="currentDisplay">—</div>
    </div>
  </div>

  <div class="ticket-modal" id="ticketModal">
    <div class="ticket-card">
      <p class="ticket-label">Ваш номерок</p>
      <div class="ticket-number" id="ticketNumber">A-001</div>
      <p class="ticket-service" id="ticketService">Консультация</p>
      <p class="ticket-time" id="ticketTime"></p>
      <button class="close-btn" onclick="closeModal()">Готово</button>
    </div>
  </div>

  <script src="queue.js"></script>
  <script>
    // Инициализация очереди для терминала
    const queue = new QueueManager();

    // Обновление текущего номера
    function updateCurrent() {
      const current = queue.getCurrent();
      document.getElementById('currentDisplay').textContent = current || '—';
    }

    // Выдача номерка
    document.querySelectorAll('.service-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const service = btn.dataset.service;
        const ticket = queue.takeTicket(service);
        if (ticket) {
          showTicket(ticket);
        }
      });
    });

    function showTicket(ticket) {
      const serviceNames = {
        consultation: 'Консультация',
        payment: 'Оплата',
        documents: 'Документы'
      };
      document.getElementById('ticketNumber').textContent = ticket.number;
      document.getElementById('ticketService').textContent = serviceNames[ticket.service];
      document.getElementById('ticketTime').textContent =
        new Date(ticket.time).toLocaleTimeString('ru-RU', {hour: '2-digit', minute: '2-digit'});
      document.getElementById('ticketModal').classList.add('active');
    }

    function closeModal() {
      document.getElementById('ticketModal').classList.remove('active');
    }

    // Слушаем изменения (между вкладками)
    window.addEventListener('storage', updateCurrent);
    setInterval(updateCurrent, 1000);
    updateCurrent();
  </script>
</body>
</html>
